# URL pública de la API REST de SHALOM (accesible desde el navegador del usuario)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# URL interna para llamadas Server-to-Server de Next.js dentro de Docker
API_INTERNAL_URL=http://server:3001/api/v1

# Gateway de WebSockets para reactividad en tiempo real (WhatsApp, Pedidos, Notificaciones)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Endpoint público para servir imágenes y multimedia desde MinIO
NEXT_PUBLIC_ASSETS_URL=http://localhost:9000/shalom-assets

# Enlace a la documentación interactiva de la API con Scalar
NEXT_PUBLIC_API_DOCS_URL=http://localhost:3001/docs
